---
// Analytics: PostHog, bundled into the site (see scripts/site.ts) and loaded
// once the page is up, so it never holds the page back. Only in production
// builds with a key set (see ANALYTICS_ON in config.ts).
//
// Tracking is on by default: a visitor who hasn't answered the cookie prompt is
// opted in at load, so PostHog's cookie and session replay start straight away.
// Switching analytics off in the cookie prompt moves to cookieless counting
// (`cookieless_mode: 'on_reject'`): no cookies or tracking storage, and the
// cookie already set is deleted.
//
// ?notrack=1 turns analytics off in this browser (for our own visits), and
// PostHog isn't even downloaded; ?notrack=0 turns it back on.
import { ANALYTICS_ON } from '../config';
---

{ANALYTICS_ON && (
  <script>
    import type { PostHog } from 'posthog-js/dist/module.full';

    const tracking = () => {
      try {
        const flag = new URLSearchParams(location.search).get('notrack');
        if (flag === '1') localStorage.setItem('spyke_notrack', '1');
        if (flag === '0') localStorage.removeItem('spyke_notrack');
        return localStorage.getItem('spyke_notrack') !== '1';
      } catch {
        return true;
      }
    };

    if (tracking()) {
      // Named events for the buttons that matter, from data-track / data-location.
      // Sent at once: "Log in" leaves the page, and a batched event could be lost.
      // A click before PostHog has loaded waits for it; one that leaves the page
      // first is lost.
      type Click = { track: string; location?: string };
      const waiting: Click[] = [];
      let ph: PostHog | null = null;
      const send = (c: Click) => ph!.capture(c.track, { location: c.location }, { send_instantly: true });

      document.addEventListener('click', (e) => {
        const el = (e.target as Element | null)?.closest<HTMLElement>('[data-track]');
        if (!el) return;
        const click = { track: el.dataset.track!, location: el.dataset.location };
        if (ph) send(click);
        else waiting.push(click);
      });

      import('../scripts/site')
        .then((m) => {
          ph = m.default;
          waiting.splice(0).forEach(send);
        })
        .catch(() => {});
    }
  </script>
)}
