---
import { DEMO_MAILTO } from '../config';

// The headline, the one-line answer to "what is it", the two ways forward,
// and a picture of the app's home page in a Mac-style window over a glow in
// the pipeline colours (the glow and the scroll effects are in global.css).
// The picture is public/home-shot.png: a 2x screenshot of the app's home
// page, 1280 by 1020, with sample data.
---

<section class="wrap hero" id="product">
  <div>
    <h1 class="h1">Agentic quoting for control panel shops.</h1>
    <p class="lead">Spyke is the quoting software that reads your drawings,<br class="wide-only" /> builds the BOM, and gets quotes out the same day.</p>
    <div class="actions">
      <a href={DEMO_MAILTO} class="btn dark">Get a demo</a>
      <a href="#how" class="btn">See how it works</a>
    </div>
  </div>

  <div class="stage">
    <div class="glow" aria-hidden="true"><span></span><span></span></div>
    <div class="shot">
      <div class="shot-bar" aria-hidden="true"><i></i><i></i><i></i></div>
      <img
        src="/home-shot.png"
        width="1280"
        height="1020"
        alt="Spyke's home page: open quotes, won this month, average margin, recent quotes, the pipeline and the quote value trend."
      />
    </div>
  </div>
</section>
