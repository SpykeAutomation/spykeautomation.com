---
import { DEMO_MAILTO } from '../config';

// The headline, the one-line answer to "what is it", the two ways forward,
// and a picture of the app's home page in a Mac-style window over a glow in
// the pipeline colours (the glow and the scroll effects are in global.css).
// The picture is public/home-shot.png: a 2x screenshot of the app's home
// page, 1280 by 1020, with sample data.
---

<section class="wrap hero" id="product">
  <div>
    <h1 class="h1">AI quoting for control panel shops.</h1>
    <p class="lead">Spyke is the quoting software that reads your drawings,<br class="wide-only" /> builds the BOM, and gets quotes out the same day, <span class="auto">automatically</span>.</p>
    <div class="actions">
      <a href={DEMO_MAILTO} class="btn dark" data-track="demo_cta_clicked" data-location="hero">Get a demo</a>
      <a href="#how" class="btn">See how it works</a>
    </div>
  </div>

  <div class="stage">
    <div class="glow" aria-hidden="true"><span></span><span></span></div>
    <div class="shot">
      <div class="shot-bar" aria-hidden="true"><i></i><i></i><i></i></div>
      <img
        src="/home-shot.png"
        width="1280"
        height="1020"
        alt="Spyke's home page: open quotes, won this month, average margin, recent quotes, the pipeline and the quote value trend."
      />
    </div>
  </div>
</section>

<script>
// Firefox and older browsers have no scroll-linked animation, so there the
// hero's scroll effects are driven from the scroll position instead, with
// the same values and ranges as the CSS in global.css: over the first 560px
// the glow deepens and the white oval over it shrinks, and over the first
// 450px the picture grows from 88% to full size. Nothing runs where the CSS
// already does the work, or where the reader has asked for reduced motion.
(() => {
  if (CSS.supports('animation-timeline: scroll()')) return;
  if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
  const glow = document.querySelector('.glow');
  const shot = document.querySelector('.shot');
  if (!glow || !shot) return;
  glow.classList.add('by-script');
  const clamp = (t) => Math.min(1, Math.max(0, t));
  let queued = false;
  const update = () => {
    queued = false;
    const g = clamp(scrollY / 560);
    glow.style.setProperty('--deepen', String(0.55 + 0.35 * g));
    glow.style.setProperty('--lift-x', String(1 - 0.429 * g));
    glow.style.setProperty('--lift-y', String(1 - 0.25 * g));
    const s = clamp(scrollY / 450);
    shot.style.transform = `scale(${0.88 + 0.12 * (1 - (1 - s) * (1 - s))})`;
  };
  const queue = () => { if (!queued) { queued = true; requestAnimationFrame(update); } };
  addEventListener('scroll', queue, { passive: true });
  update();
})();
</script>
