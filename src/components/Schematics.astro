          <!-- terminal strip TB-3 -->
          <text x="362" y="66" font-family="Geist Mono, monospace" font-size="12" fill="#525252" text-anchor="middle">TB-3</text>
          <rect x="344" y="76" width="36" height="230" rx="3" fill="#fafafa" stroke="#171717" stroke-width="1.5"/>
          <g fill="#fff" stroke="#171717" stroke-width="1.5">
            <rect x="348" y="82" width="28" height="28" rx="2"/>
            <rect x="348" y="144" width="28" height="28" rx="2"/>
            <rect x="348" y="206" width="28" height="28" rx="2"/>
            <rect x="348" y="268" width="28" height="28" rx="2"/>
          </g>
          <g font-family="Geist Mono, monospace" font-size="11" fill="#171717" text-anchor="middle">
            <text x="362" y="100">12</text>
            <text x="362" y="162">13</text>
            <text x="362" y="224">14</text>
            <text x="362" y="286">15</text>
          </g>

          <!-- input card, slot 3 -->
          <rect x="508" y="52" width="116" height="262" rx="6" fill="#fff" stroke="#171717" stroke-width="2"/>
          <text x="566" y="72" font-family="Instrument Sans, sans-serif" font-size="10.5" font-weight="600" fill="#171717" text-anchor="middle">INPUT · SLOT 3</text>
          <line x1="508" y1="82" x2="624" y2="82" stroke="#171717" stroke-width="1.5"/>
          <g font-family="Instrument Sans, sans-serif" font-size="11.5" fill="#525252">
            <text x="522" y="100">IN 4</text>
            <text x="522" y="162">IN 5</text>
            <text x="522" y="224">IN 6</text>
            <text x="522" y="286">IN 7</text>
          </g>

          <!-- row 1 — start pushbutton -->
          <g stroke="#171717" stroke-width="2" fill="none" stroke-linecap="round">
            <line x1="72" y1="96" x2="88" y2="96"/><circle cx="100" cy="96" r="12"/>
            <line x1="112" y1="96" x2="344" y2="96"/><line x1="380" y1="96" x2="508" y2="96"/>
          </g>
          <text x="100" y="62" font-family="Instrument Sans, sans-serif" font-size="11.5" fill="#525252" text-anchor="middle">START PB</text>
          <text x="100" y="76" font-family="Geist Mono, monospace" font-size="10" fill="#737373" text-anchor="middle">PB-3</text>
          <text x="228" y="88" font-family="Geist Mono, monospace" font-size="10" fill="#737373" text-anchor="middle">311</text>
          <text x="444" y="88" font-family="Geist Mono, monospace" font-size="10" fill="#737373" text-anchor="middle">311</text>

          <!-- row 2 — the guard door switch REV C added yesterday -->
          <g stroke="#171717" stroke-width="2" fill="none" stroke-linecap="round">
            <line x1="72" y1="158" x2="88" y2="158"/><circle cx="100" cy="158" r="12"/>
            <line x1="112" y1="158" x2="344" y2="158"/><line x1="380" y1="158" x2="508" y2="158"/>
          </g>
          <text x="100" y="124" font-family="Instrument Sans, sans-serif" font-size="11.5" fill="#525252" text-anchor="middle">GUARD DOOR SW</text>
          <text x="100" y="138" font-family="Geist Mono, monospace" font-size="10" fill="#737373" text-anchor="middle">GS-3</text>
          <text x="228" y="150" font-family="Geist Mono, monospace" font-size="10" fill="#737373" text-anchor="middle">312</text>
          <text x="444" y="150" font-family="Geist Mono, monospace" font-size="10" fill="#737373" text-anchor="middle">312</text>

          <!-- row 3 — the redline: PE-31 takes the spare terminal -->
          <g class="rl-new">
            <g class="rl-dev" stroke="#171717" stroke-width="2" fill="none" stroke-linecap="round">
              <line x1="72" y1="220" x2="88" y2="220"/><circle cx="100" cy="220" r="12"/>
            </g>
            <line class="rl-wire" x1="112" y1="220" x2="344" y2="220" stroke="#171717" stroke-width="2" stroke-linecap="round" pathLength="1"/>
            <line class="rl-wire w2" x1="380" y1="220" x2="508" y2="220" stroke="#171717" stroke-width="2" stroke-linecap="round" pathLength="1"/>
            <g class="rl-lbl">
              <text x="100" y="186" font-family="Instrument Sans, sans-serif" font-size="11.5" fill="#525252" text-anchor="middle">JAM DET PE</text>
              <text x="100" y="200" font-family="Geist Mono, monospace" font-size="10" fill="#737373" text-anchor="middle">PE-31</text>
              <text x="228" y="212" font-family="Geist Mono, monospace" font-size="10" fill="#737373" text-anchor="middle">314</text>
              <text x="444" y="212" font-family="Geist Mono, monospace" font-size="10" fill="#737373" text-anchor="middle">314</text>
            </g>
          </g>
          <text class="lbl-spare" x="336" y="216" font-family="Geist Mono, monospace" font-size="10.5" fill="#737373" text-anchor="end">SPARE</text>
          <line class="rl-strike" x1="296" y1="212" x2="340" y2="212" stroke="#d20f39" stroke-width="2" stroke-linecap="round" pathLength="1"/>
          <g class="rl-strike-badge">
            <circle cx="288" cy="212" r="8" fill="#d20f39"/>
            <text x="288" y="216" font-family="Instrument Sans, sans-serif" font-size="12" font-weight="600" fill="#fff" text-anchor="middle">−</text>
          </g>
          <g class="rl-badge">
            <circle cx="504" cy="172" r="9" fill="#047857"/>
            <text x="504" y="176.5" font-family="Instrument Sans, sans-serif" font-size="13" font-weight="600" fill="#fff" text-anchor="middle">+</text>
          </g>

          <!-- row 4 — stop pushbutton -->
          <g stroke="#171717" stroke-width="2" fill="none" stroke-linecap="round">
            <line x1="72" y1="282" x2="88" y2="282"/><circle cx="100" cy="282" r="12"/>
            <line x1="112" y1="282" x2="344" y2="282"/><line x1="380" y1="282" x2="508" y2="282"/>
          </g>
          <text x="100" y="248" font-family="Instrument Sans, sans-serif" font-size="11.5" fill="#525252" text-anchor="middle">STOP PB</text>
          <text x="100" y="262" font-family="Geist Mono, monospace" font-size="10" fill="#737373" text-anchor="middle">PB-4</text>
          <text x="228" y="274" font-family="Geist Mono, monospace" font-size="10" fill="#737373" text-anchor="middle">315</text>
          <text x="444" y="274" font-family="Geist Mono, monospace" font-size="10" fill="#737373" text-anchor="middle">315</text>

          <!-- title block -->
          <rect x="356" y="330" width="279" height="65" fill="#fff" stroke="#171717" stroke-width="1.5"/>
          <line x1="356" y1="363" x2="635" y2="363" stroke="#171717" stroke-width="1.5"/>
          <line x1="505" y1="363" x2="505" y2="395" stroke="#171717" stroke-width="1.5"/>
          <line x1="578" y1="363" x2="578" y2="395" stroke="#171717" stroke-width="1.5"/>
          <text x="368" y="351" font-family="Instrument Sans, sans-serif" font-size="13" font-weight="600" fill="#171717">CONVEYOR INFEED — I/O WIRING</text>
          <text x="368" y="383" font-family="Instrument Sans, sans-serif" font-size="10.5" fill="#525252">PACKAGING_LINE · LINE 3</text>
          <text x="513" y="374" font-family="Instrument Sans, sans-serif" font-size="8" fill="#737373">SHEET</text>
          <text x="513" y="389" font-family="Geist Mono, monospace" font-size="12.5" fill="#171717">E-402</text>
          <text x="586" y="374" font-family="Instrument Sans, sans-serif" font-size="8" fill="#737373">REV</text>
          <text class="rev-c" x="596" y="390" font-family="Geist Mono, monospace" font-size="15" font-weight="600" fill="#171717">C</text>
          <text class="rev-d" x="596" y="390" font-family="Geist Mono, monospace" font-size="15" font-weight="600" fill="#171717">D</text>
        </svg>
      </div>

      <div class="rail-col srail">
        <h5>Describe the change</h5>
        <div class="say">Added a photoeye at the infeed for jam detection. Wired it to terminal 14 on TB-3 and input 6 on the slot 3 card.</div>
        <div class="swap3">
          <span class="pill neutral n1">Drafting redline…</span>
          <span class="pill neutral n2">Redline ready · 1 addition, 1 removal</span>
          <span class="pill green n3">✓ Schematic synced</span>
        </div>
        <span class="rail-btn">
          <span class="swap"><span class="s-a">Approve redline</span><span class="s-b">✓ Approved</span></span>
          <span class="cursor" aria-hidden="true"><span class="cur-in"><svg width="38" height="38" viewBox="0 0 20 20"><path d="M4 2.5 15.5 9.8 10.2 10.6 7.6 15.6Z" fill="#171717" stroke="#fff" stroke-width="1.2" stroke-linejoin="round"/></svg></span></span>
          <span class="btn-ring" aria-hidden="true"></span>
        </span>
        <h5 class="shist-head">History</h5>
        <div class="shist">
          <div class="hist-row hist-new"><span class="id">REV D</span> Add jam detect photoeye <span class="who">just now</span></div>
          <div class="hist-row"><span class="id">REV C</span> Add guard door interlock <span class="who">yesterday</span></div>
          <div class="hist-row"><span class="id">REV B</span> Split infeed junction box <span class="who">May 12</span></div>
        </div>
      </div>
      </div>
    </div>
  </div>
</section>

<script>
  // The demo's choreography. The phase flips (.drafting, .drafted) run on the
  // same stopwatch as the typing, and .approved is made by the cursor's click
  // so the cursor and the UI can't drift apart. With no JS or reduced motion,
  // the mock just sits at its authored resting state.
  (() => {
    const m = document.querySelector<HTMLElement>('.smock');
    if (!m) return;
    const say = m.querySelector<HTMLElement>('.say');
    const cur = m.querySelector<HTMLElement>('.cursor');
    const btn = m.querySelector<HTMLElement>('.rail-btn');
    const ring = m.querySelector<SVGGraphicsElement>('.rl-ring');
    if (!say || !cur || !btn || !ring) return;

    say.dataset.text = say.textContent?.trim() ?? '';
    if (matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) return;

    // The cursor travels in the mock's coordinate space, not the button's.
    m.appendChild(cur);

    let run = 0;
    let timers: ReturnType<typeof setTimeout>[] = [];
    const at = (ms: number, fn: () => void) => timers.push(setTimeout(fn, ms));

    // The arrow's point sits a few px in from the SVG's corner.
    const TIP_X = 7;
    const TIP_Y = 5;
    const to = (el: Element, dx = 0, dy = 0) => {
      const a = el.getBoundingClientRect();
      const b = m.getBoundingClientRect();
      return [a.left - b.left + a.width / 2 - TIP_X + dx, a.top - b.top + a.height / 2 - TIP_Y + dy];
    };
    const put = (x: number, y: number, ms: number) => {
      cur.style.transition = ms ? `transform ${ms}ms cubic-bezier(.33,.9,.3,1)` : 'none';
      cur.style.transform = `translate(${x}px,${y}px)`;
      // A same-frame "jump then move" coalesces into one animated move from the
      // old position; forcing a reflow commits the jump first.
      if (!ms) void cur.offsetWidth;
    };
    const click = (fn?: () => void) => {
      cur.classList.add('press');
      at(140, () => {
        cur.classList.remove('press');
        fn?.();
      });
    };
    const write = (b: HTMLElement, start: number, speed: number) => {
      const t = b.dataset.text ?? '';
      at(start, () => {
        b.classList.add('writing');
        b.textContent = '';
        let i = 0;
        const tick = () => {
          b.textContent = t.slice(0, ++i);
          if (i < t.length) timers.push(setTimeout(tick, speed + (i % 5) * 2));
          else b.classList.remove('writing');
        };
        timers.push(setTimeout(tick, speed));
      });
    };

    const play = () => {
      const mine = ++run;
      timers.forEach(clearTimeout);
      timers = [];
      // Retoggle the state classes so the CSS-driven parts restart in step
      // with the timers on every loop.
      m.classList.remove('play', 'drafting', 'drafted', 'panout', 'approved');
      void m.offsetWidth;
      m.classList.add('play');
      cur.classList.remove('press');
      cur.style.opacity = '0';
      {
        const [x, y] = to(ring);
        put(x, y, 0);
      }
      // Lock the input to the height of its finished text before emptying it,
      // so the rail doesn't grow line by line as the description types out.
      say.classList.remove('writing');
      say.textContent = say.dataset.text ?? '';
      say.style.minHeight = '';
      say.style.minHeight = `${say.offsetHeight}px`;
      say.textContent = '';

      write(say, 500, 18);
      at(3400, () => m.classList.add('drafting'));
      at(4200, () => m.classList.add('drafted'));
      // The camera pulls back once the redline is drawn; the cursor waits for
      // it (the pan takes .8s) so its measured flight happens at scale 1.
      at(5900, () => m.classList.add('panout'));
      // The cursor starts on the fresh redline — where the reader's eye
      // already is — then flies to Approve. No detour.
      at(6800, () => {
        const [x, y] = to(ring);
        put(x, y, 0);
        cur.style.opacity = '1';
      });
      at(7200, () => {
        const [x, y] = to(btn);
        put(x, y, 900);
      });
      at(8250, () => click(() => m.classList.add('approved')));
      at(9600, () => {
        cur.style.transition = 'transform .5s ease,opacity .4s ease';
        cur.style.opacity = '0';
      });
      // Hold the synced state, then go around again.
      at(14200, () => {
        if (mine === run && looping) play();
      });
    };

    // The demo loops while it's on screen and rests while it isn't. Leaving
    // resets it to the authored drafted state so a mid-type freeze is never
    // what's sitting there when it scrolls back into view.
    let looping = false;
    const io = new IntersectionObserver(
      (entries) =>
        entries.forEach((e) => {
          if (e.isIntersecting) {
            if (!looping) {
              looping = true;
              play();
            }
          } else if (looping) {
            looping = false;
            run++;
            timers.forEach(clearTimeout);
            timers = [];
            m.classList.remove('play', 'drafting', 'drafted', 'panout', 'approved');
            cur.style.opacity = '0';
            say.classList.remove('writing');
            say.textContent = say.dataset.text ?? '';
          }
        }),
      { threshold: 0.35 },
    );
    io.observe(m);
  })();
</script>
