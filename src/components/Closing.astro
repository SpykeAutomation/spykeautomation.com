---
import { DEMO_MAILTO } from '../config';

// The page's last word, on the black ground it shares with the footer, over
// a fine grid. The button opens an email; the address is also in the
// footer as text, for a computer with no mail app set up.
---

<section class="closing" id="demo">
  <div class="wrap">
    <h2 class="h2">Modern panel shops<br /> run on Spyke.</h2>
    <p>Book a personalized demo and see how Spyke fits your workflow.</p>
    <div class="actions">
      <a href={DEMO_MAILTO} class="btn light" data-track="demo_cta_clicked" data-location="closing">Get a demo</a>
    </div>
  </div>
</section>
