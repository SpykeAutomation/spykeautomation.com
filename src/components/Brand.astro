---
// The Spyke mark and name. The mark is five bands in the app's pipeline
// colours (Draft, In Progress, In Review, Sent, Won) gathered by a cable tie.
// The tie takes the text colour, so it is dark on the white top bar and light
// on the black footer, and the slot in its head is cut out, so the ground
// behind the logo shows through it. Sizing comes from the `.brand` rules in
// global.css. With no href it renders as plain text, as it does inside a
// product illustration.
interface Props {
  href?: string | null;
}
const { href = '/' } = Astro.props;
const Tag = href ? 'a' : 'span';
// The cut-out is a mask, and a mask needs an id; a page shows the logo more
// than once, so each copy gets its own.
const mask = `spyke-slot-${Math.random().toString(36).slice(2, 8)}`;
---

<Tag class="brand" href={href ?? undefined}>
  <svg class="logo" viewBox="0 0 192 192" aria-hidden="true" focusable="false">
    <mask id={mask} maskUnits="userSpaceOnUse" x="0" y="0" width="192" height="192">
      <rect width="192" height="192" fill="#fff" />
      <path fill="#000" d="M136.2 86.7H147.6a2.5 2.5 0 0 1 2.5 2.5V103.8a2.5 2.5 0 0 1 -2.5 2.5H136.2a2.5 2.5 0 0 1 -2.5 -2.5V89.2a2.5 2.5 0 0 1 2.5 -2.5Z" />
    </mask>
    <g mask={`url(#${mask})`}>
      <path fill="#8e8e93" d="M3 4.5C3 50.5 56 64 56 96S3 141.5 3 187.5H32C32 139.5 69 133 69 96S32 52.5 32 4.5Z" />
      <path fill="#5a7ed9" d="M42 4.5C42 47.5 75.2 74 75.2 96S42 144.5 42 187.5H71C71 141.5 87 130 87 96S71 50.5 71 4.5Z" />
      <path fill="#deac3e" d="M82 4.5C82 60.5 88 54 88 96S82 131.5 82 187.5H110C110 131.5 104 138 104 96S110 60.5 110 4.5Z" />
      <path fill="#796dd4" d="M121 4.5C121 50.5 105 62 105 96S121 141.5 121 187.5H150C150 144.5 116.8 118 116.8 96S150 47.5 150 4.5Z" />
      <path fill="#5eab71" d="M160 4.5C160 52.5 123 59 123 96S160 139.5 160 187.5H189C189 141.5 136 128 136 96S189 50.5 189 4.5Z" />
      <path fill="currentColor" d="M44.2 81.7H124.2a4 4 0 0 1 4 4V107.3a4 4 0 0 1 -4 4H44.2a4 4 0 0 1 -4 -4V85.7a4 4 0 0 1 4 -4ZM129.2 72H154.6a7 7 0 0 1 7 7V114a7 7 0 0 1 -7 7H129.2a7 7 0 0 1 -7 -7V79a7 7 0 0 1 7 -7Z" />
    </g>
  </svg>Spyke Automation
</Tag>
