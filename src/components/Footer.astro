---
import Brand from './Brand.astro';
import { APP_URL, CONTACT_EMAIL } from '../config';
// The year the site was built; the deploy runs on every push.
const year = new Date().getFullYear();
// Only links to things that exist: the home page's sections, the contact
// address, the app, and the legal pages. The section links are written as
// "/#…" so they also work from the privacy and terms pages.
---

<footer class="foot">
  <div class="wrap">
    <div>
      <Brand href="/" />
    </div>

    <div>
      <p class="foot-head">Product</p>
      <ul>
        <li><a href="/#how">How it works</a></li>
        <li><a href="/#pricing">Your rules</a></li>
        <li><a href="/#quote">Quotes</a></li>
      </ul>
    </div>

    <div>
      <p class="foot-head">Company</p>
      <ul>
        <li><a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a></li>
        <li><a href={APP_URL}>Log in</a></li>
      </ul>
    </div>

    <div class="legal-links">
      <p>© {year} Spyke Automation<br />All rights reserved.</p>
      <div><a href="/privacy/">Privacy</a><a href="/terms/">Terms</a></div>
    </div>
  </div>

  <!-- SPYKE in letters as wide as the column, cut off by the bottom of the
       page. Decorative; the brand link above already names the site. -->
  <div class="giant" aria-hidden="true"><span>SPYKE</span></div>
</footer>
