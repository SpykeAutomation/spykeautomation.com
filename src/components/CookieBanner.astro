---
// The cookie banner. Tracking is already on when it appears (see
// Analytics.astro); Reject all turns cookies and session replay off. It stays
// hidden until PostHog has loaded, and then shows only if the visitor hasn't
// answered yet. If PostHog is blocked or
// switched off, neither this bar nor the footer's "Cookie settings" appears:
// nothing is being tracked, so there is nothing to ask.
import { ANALYTICS_ON } from '../config';
---

{ANALYTICS_ON && (
  <div class="cookie-banner" id="cookieBanner" role="region" aria-labelledby="cookieTitle" hidden>
    <p class="cookie-title" id="cookieTitle">We use cookies</p>
    <p class="cookie-text">
      We use analytics cookies to understand how visitors use our site and to improve it. Choose
      Reject all to turn them off. You can change your choice at any time under "Cookie settings".
      <a href="/privacy/">Privacy Policy</a>
    </p>
    <div class="cookie-actions">
      {/* Same style on both: a choice, not a nudge. */}
      <button type="button" class="btn dark" data-consent="denied">Reject all</button>
      <button type="button" class="btn dark" data-consent="granted">Accept all</button>
    </div>
  </div>
)}

<script>
  type PostHog = {
    __loaded?: boolean;
    get_explicit_consent_status(): 'granted' | 'denied' | 'pending';
    opt_in_capturing(options?: { captureEventName?: string | false }): void;
    opt_out_capturing(): void;
    capture(event: string): void;
  };

  // PostHog's own consent state reads "granted" for everyone who hasn't
  // rejected, answered or not, so the visitor's actual answer is kept here.
  const CHOICE = 'spyke_cookie_choice';
  const readChoice = () => {
    try { return localStorage.getItem(CHOICE); } catch { return null; }
  };
  const saveChoice = (choice: string) => {
    try { localStorage.setItem(CHOICE, choice); } catch {}
  };

  const bar = document.getElementById('cookieBanner');
  const settings = document.getElementById('cookie-settings');

  const start = (ph: PostHog) => {
    if (!bar) return;
    let openedFrom: HTMLElement | null = null;

    const close = () => {
      bar.hidden = true;
      if (openedFrom) openedFrom.focus();
      else document.getElementById('main')?.focus({ preventScroll: true });
      openedFrom = null;
    };

    bar.querySelectorAll<HTMLButtonElement>('[data-consent]').forEach((button) => {
      button.addEventListener('click', () => {
        const choice = button.dataset.consent!;
        // Picking the same answer again changes nothing and isn't counted twice.
        if (choice !== readChoice()) {
          saveChoice(choice);
          const status = ph.get_explicit_consent_status();
          if (choice === 'granted') {
            if (status !== 'granted') ph.opt_in_capturing({ captureEventName: false });
            ph.capture('consent_accepted');
          } else if (status !== 'denied') {
            ph.opt_out_capturing();
            ph.capture('consent_declined');
          }
        }
        close();
      });
    });

    if (settings) {
      settings.hidden = false;
      settings.addEventListener('click', () => {
        openedFrom = settings;
        bar.hidden = false;
        bar.querySelector<HTMLButtonElement>('[data-consent="granted"]')?.focus();
      });
    }

    // Visitors who rejected before this change have no saved answer, but have answered.
    if (!readChoice() && ph.get_explicit_consent_status() !== 'denied') bar.hidden = false;
  };

  const w = window as unknown as { posthog?: PostHog };
  if (w.posthog?.__loaded) start(w.posthog);
  else document.addEventListener('ph:loaded', (e) => start((e as CustomEvent<PostHog>).detail), { once: true });
</script>
