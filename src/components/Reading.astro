    <g fill="var(--cell, #a1a1aa)" stroke="none"><rect x="200" y="46" width="10" height="4"/><rect x="220" y="46" width="44" height="4"/><rect x="290" y="46" width="38" height="4"/><rect x="342" y="46" width="8" height="4"/><rect x="200" y="63" width="10" height="4"/><rect x="220" y="63" width="37" height="4"/><rect x="290" y="63" width="33" height="4"/><rect x="342" y="63" width="11" height="4"/><rect x="200" y="80" width="10" height="4"/><rect x="220" y="80" width="30" height="4"/><rect x="290" y="80" width="28" height="4"/><rect x="342" y="80" width="14" height="4"/><rect x="200" y="97" width="10" height="4"/><rect x="220" y="97" width="41" height="4"/><rect x="290" y="97" width="37" height="4"/><rect x="342" y="97" width="9" height="4"/><rect x="200" y="114" width="10" height="4"/><rect x="220" y="114" width="34" height="4"/><rect x="290" y="114" width="32" height="4"/><rect x="342" y="114" width="12" height="4"/><rect x="200" y="131" width="10" height="4"/><rect x="220" y="131" width="27" height="4"/><rect x="290" y="131" width="27" height="4"/><rect x="342" y="131" width="15" height="4"/><rect x="200" y="148" width="10" height="4"/><rect x="220" y="148" width="38" height="4"/><rect x="290" y="148" width="36" height="4"/><rect x="342" y="148" width="10" height="4"/></g>
    <g fill="var(--text, #a1a1aa)" stroke="none"><rect x="20" y="228" width="120" height="4"/><rect x="20" y="238" width="96" height="4"/><rect x="20" y="248" width="108" height="4"/><rect x="262" y="227" width="50" height="4"/><rect x="326" y="227" width="40" height="4"/><rect x="262" y="241" width="44" height="4"/><rect x="262" y="255" width="56" height="4"/><rect x="326" y="255" width="30" height="4"/></g>
  </symbol>
</svg>

<section class="reading" id="reading" aria-labelledby="reading-title">
    <div class="wrap">
      <div class="reading-head">
        <h2 class="h2" id="reading-title">Built for accuracy.</h2>
        <p>Every drawing is processed, structured, and checked before it reaches your estimate, reducing manual data entry work and giving your team more time to build.</p>
      </div>

      <div class="explode" aria-hidden="true">
        <div class="stack">
          <!-- 1: the scan as it arrives, tilted and speckled: the base sheet -->
          <div class="layer base" style="--i:0;--paper:#f3f1ea;--ink:#8f8f95;--grid:#8f8f95;--text:#a1a1aa;--cell:#a1a1aa;--head:#71717a">
            <svg viewBox="0 0 400 280">
              <defs><pattern id="speckle" width="23" height="17" patternUnits="userSpaceOnUse"><circle cx="3" cy="4" r=".7" fill="#9a968c"/><circle cx="15" cy="11" r=".5" fill="#9a968c"/><circle cx="9" cy="15" r=".4" fill="#b3aea2"/></pattern></defs>
              <use href="#sheet" transform="rotate(1.8 200 140)"/>
              <rect width="400" height="280" fill="url(#speckle)" opacity=".9"/>
            </svg>
          </div>
          <!-- 2: straightened and cleaned -->
          <div class="layer" style="--i:1;--paper:rgba(255,255,255,.9);--ink:#52525b;--grid:#52525b;--text:#8e8e93;--cell:#8e8e93;--head:#3f3f46">
            <svg viewBox="0 0 400 280"><use href="#sheet"/></svg>
          </div>
          <!-- 3: the ruled lines traced, and nothing else -->
          <div class="layer" style="--i:2;--paper:transparent;--ink:transparent;--text:transparent;--head:transparent;--cell:transparent;--grid:#6ea0ff;--grid-w:2.2">
            <svg viewBox="0 0 400 280"><use href="#sheet"/></svg>
          </div>
          <!-- 4: the parts list found -->
          <div class="layer" style="--i:3;--paper:transparent;--ink:transparent;--text:transparent;--grid:transparent;--cell:transparent;--list:#f5b83d;--list-fill:rgba(245,184,61,.2);--head-fill:rgba(245,184,61,.55);--head:#fde7b0">
            <svg viewBox="0 0 400 280"><use href="#sheet"/></svg>
          </div>
          <!-- 5: the parts list read twice and checked: one cell flagged, the rest ticked -->
          <div class="layer" style="--i:4;--paper:transparent;--ink:transparent;--text:transparent;--grid:transparent;--head:#ffffff;--cell:#e4e4e7">
            <svg viewBox="0 0 400 280"><use href="#sheet"/>
              <rect x="287" y="92" width="48" height="16" fill="rgba(167,139,250,.32)" stroke="#a78bfa" stroke-width="1.5"/>
              <g fill="none" stroke="#4ade80" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M381 47l3 3 5-6M381 64l3 3 5-6M381 81l3 3 5-6M381 115l3 3 5-6M381 132l3 3 5-6M381 149l3 3 5-6"/></g>
            </svg>
          </div>
        </div>
      </div>
    </div>
  </section>

<script>
// Firefox and older browsers have no scroll-linked animation, so there the
// build-up is driven from the scroll position instead, with the same ranges
// as the CSS in global.css. Nothing runs where the CSS already does the
// work, or where the reader has asked for reduced motion.
(() => {
  const explode = document.querySelector('.explode');
  if (!explode || CSS.supports('animation-timeline: view()')) return;
  if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
  const stack = explode.querySelector('.stack');
  const layers = [...explode.querySelectorAll('.layer:not(.base)')];
  // Progress through a range of the section's passage, eased out.
  const part = (p, from, to) => {
    const t = Math.min(1, Math.max(0, (p - from) / (to - from)));
    return 1 - (1 - t) * (1 - t);
  };
  let queued = false;
  const update = () => {
    queued = false;
    const box = explode.getBoundingClientRect();
    // 0 as the section's top enters at the bottom of the window, 1 as its
    // bottom leaves at the top: the CSS "cover" range.
    const p = (innerHeight - box.top) / (innerHeight + box.height);
    const spread = part(p, 0.05, 0.48);
    stack.style.setProperty('--gap', `${6 + 58 * spread}px`);
    stack.style.setProperty('--spin', `${-14 + 14 * spread}deg`);
    layers.forEach((layer, i) => {
      const t = part(p, 0.08 + i * 0.08, 0.24 + i * 0.08);
      layer.style.opacity = String(t);
      layer.style.translate = `0 0 ${180 * (1 - t)}px`;
    });
  };
  const queue = () => { if (!queued) { queued = true; requestAnimationFrame(update); } };
  addEventListener('scroll', queue, { passive: true });
  addEventListener('resize', queue);
  update();
})();
</script>
