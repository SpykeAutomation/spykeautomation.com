"26" cy="74" r="1.6"/><circle cx="36" cy="86" r="1.6"/><rect x="132" y="48.5" width="16" height="3"/><rect x="132" y="60.5" width="16" height="3"/><rect x="132" y="72.5" width="16" height="3"/><rect x="132" y="84.5" width="16" height="3"/><rect x="132" y="96.5" width="16" height="3"/><rect x="132" y="108.5" width="16" height="3"/><rect x="132" y="120.5" width="16" height="3"/><rect x="132" y="132.5" width="16" height="3"/><rect x="130" y="30" width="30" height="4"/><circle cx="64" cy="110" r="1.6"/><circle cx="64" cy="122" r="1.6"/><text x="36" y="157.5" font-size="9" font-weight="600" text-anchor="middle">M</text></g><g fill="var(--ink, #71717a)" stroke="none" font-size="5.5" font-weight="500"><text x="54" y="42">DS1</text><text x="52" y="60">FU1</text><text x="52" y="100">K1</text><text x="52" y="119">OL1</text><text x="52" y="156">M1</text><text x="66" y="70">T1</text><text x="100" y="92">TB1</text><text x="150" y="158">PLC</text></g>
    <rect x="196" y="24" width="180" height="136" fill="var(--list-fill, none)" stroke="none"/>
    <rect x="196" y="24" width="180" height="16" fill="var(--head-fill, none)" stroke="none"/>
    <g fill="none" stroke="var(--grid, #71717a)" stroke-width="var(--grid-w, 1)"><rect x="196" y="24" width="180" height="136"/><path d="M196 40H376"/><path d="M196 57H376"/><path d="M196 74H376"/><path d="M196 91H376"/><path d="M196 108H376"/><path d="M196 125H376"/><path d="M196 142H376"/><path d="M216 24V160M286 24V160M336 24V160"/><rect x="256" y="222" width="128" height="42"/><path d="M256 236H384M256 250H384M320 222V264"/></g>
    <rect x="196" y="24" width="180" height="136" fill="none" stroke="var(--list, none)" stroke-width="2.5"/>
