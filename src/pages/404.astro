---
// Cloudflare Pages serves this for any URL that doesn't exist. Without it,
// Pages treats the site as a single-page app and answers every bad URL with
// the home page and a 200.
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Page not found — Spyke Automation" noindex>
  <Nav />
  <main class="legal" id="main" tabindex="-1">
    <div class="wrap">
      <h1>Page not found</h1>
      <p class="lead">The page you're looking for doesn't exist or has moved.</p>
      <p><a class="btn dark" href="/">Go to the home page</a></p>
    </div>
  </main>
  <Footer />
</Layout>
