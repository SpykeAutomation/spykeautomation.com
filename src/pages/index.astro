---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Features from '../components/Features.astro';
import Review from '../components/Review.astro';
import Schematics from '../components/Schematics.astro';
import Booking from '../components/Booking.astro';
import CTA from '../components/CTA.astro';
import Footer from '../components/Footer.astro';
import ComingSoon from '../components/ComingSoon.astro';
import { PAUSED } from '../config';
---

{
  PAUSED ? (
    <Layout
      title="Spyke Automation"
      description="Something exciting is coming soon."
    >
      <ComingSoon />
    </Layout>
  ) : (
    <Layout>
      <Nav />
      <main id="main">
        <Hero />
        <Features />
        <Review />
        <Schematics />
        <Booking />
        <CTA />
      </main>
      <Footer />
    </Layout>
  )
}
