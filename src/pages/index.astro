---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Trust from '../components/Trust.astro';
import Reading from '../components/Reading.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Pricing from '../components/Pricing.astro';
import Quotes from '../components/Quotes.astro';
import Values from '../components/Values.astro';
import Closing from '../components/Closing.astro';
import Footer from '../components/Footer.astro';
import ComingSoon from '../components/ComingSoon.astro';
import { PAUSED } from '../config';
---

{
  PAUSED ? (
    <Layout
      title="Spyke Automation"
      description="Something exciting is coming soon."
    >
      <ComingSoon />
    </Layout>
  ) : (
    <Layout>
      <Nav />
      <main id="main">
        <Hero />
        <Trust />
        <Reading />
        <HowItWorks />
        <Pricing />
        <Quotes />
        <Values />
        <Closing />
      </main>
      <Footer />
    </Layout>
  )
}
